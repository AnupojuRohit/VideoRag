POSTGRES_DB=videorag
POSTGRES_USER=videorag
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql+asyncpg://videorag:replace-with-a-local-development-password@localhost:5432/videorag
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
LOG_LEVEL=INFO
MEDIA_ROOT=./data
MAX_UPLOAD_BYTES=500000000
MAX_VIDEO_DURATION_SECONDS=3600
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT_SECONDS=30
FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT_SECONDS=1800
JOB_LEASE_SECONDS=90
JOB_DISPATCH_COOLDOWN_SECONDS=60
JOB_RECONCILE_INTERVAL_SECONDS=15
JOB_MAX_ATTEMPTS=5
WORKER_CONCURRENCY=2
AUDIO_SEGMENT_SECONDS=1500
AUDIO_SEGMENT_OVERLAP_SECONDS=2
TRANSCRIPTION_REQUEST_TIMEOUT_SECONDS=600
# Create this key from a Gemini API project with no active billing account.
# Free-tier audio may be used to improve Google's products and reviewed by
# humans. Never send sensitive, confidential, or personal audio.
# GEMINI_API_KEY=
# Set true only after accepting the unpaid-service data terms above.
GEMINI_UNPAID_API_ACKNOWLEDGED=false
# Set these together only after a compliant embedding provider/model is verified.
# EMBEDDING_MODEL_ID=
# EMBEDDING_MODEL_VERSION=
# EMBEDDING_DIMENSION=

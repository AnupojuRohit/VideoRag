POSTGRES_DB=videorag
POSTGRES_USER=videorag
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql+asyncpg://videorag:replace-with-a-local-development-password@localhost:5432/videorag
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
LOG_LEVEL=INFO
MEDIA_ROOT=./data
MAX_UPLOAD_BYTES=500000000
MAX_VIDEO_DURATION_SECONDS=3600
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT_SECONDS=30
FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT_SECONDS=1800
SCENE_DETECTION_TIMEOUT_SECONDS=1800
SCENE_THRESHOLD=27
FRAME_EXTRACTION_TIMEOUT_SECONDS=60
FRAME_SAMPLING_INTERVAL_SECONDS=15
FRAME_MIN_SPACING_SECONDS=2
MAX_FRAMES_PER_VIDEO=120
FRAME_MAX_DIMENSION=1280
PERCEPTUAL_HASH_DISTANCE=4
TESSERACT_PATH=tesseract
TESSERACT_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=20
VISION_REQUEST_TIMEOUT_SECONDS=180
VISION_MAX_IMAGE_BYTES=10000000
JOB_LEASE_SECONDS=90
JOB_DISPATCH_COOLDOWN_SECONDS=60
JOB_RECONCILE_INTERVAL_SECONDS=15
JOB_MAX_ATTEMPTS=5
WORKER_CONCURRENCY=2
AUDIO_SEGMENT_SECONDS=1500
AUDIO_SEGMENT_OVERLAP_SECONDS=2
TRANSCRIPTION_REQUEST_TIMEOUT_SECONDS=600
# Create this key from a Gemini API project with no active billing account.
# Use Gemini API only if the operator is 18+ and this is for a professional or
# business purpose, not consumer use or an application directed to minors.
# Unpaid-tier content may be used to improve Google products and human-reviewed.
# Never send sensitive, confidential, or personal content.
# GEMINI_API_KEY=
# Set both acknowledgements true only after reviewing Google's current terms
# and confirming that this project has no active billing account.
GEMINI_UNPAID_API_ACKNOWLEDGED=false
GEMINI_API_TERMS_ACKNOWLEDGED=false
EMBEDDING_MODEL_ID=gemini-embedding-001
EMBEDDING_MODEL_VERSION=stable
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=4
